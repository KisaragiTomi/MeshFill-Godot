[node name="TargetSVBrushOverlayDemo" type="Node3D"]
script = ExtResource("1_demo")
metadata/source_doc = "res://demos/target-sv-point-cloud-conversion-c/target-scene-voxel-projection.md"
metadata/source_docs = "res://demos/target-sv-point-cloud-conversion-c/target-scene-voxel-projection.md;res://demos/target-sv-point-cloud-conversion-c/target-sv-point-cloud-conversion.md"
metadata/test_doc = "res://demos/target-sv-point-cloud-conversion-c/targetsv-brush-overlay.md"
metadata/focus = "Unified TargetSV demo: point-cloud guidance field (GPU box voxels via VoxelDisplay) + mouse-painted brush voxels (tetrahedra GPU compute). Brush instance transforms/colors are produced on the GPU (Vulkan RenderingDevice storage buffer compute) and uploaded once via multimesh_set_buffer; without RD the GPU upload SKIPs, no CPU fallback."
metadata/gpu_required = true
metadata/gpu_subitems = "gpu_upload;gpu_readback"
metadata/cpu_fallback = false

