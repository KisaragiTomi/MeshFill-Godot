<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:y="http://www.yworks.com/xml/graphml"
  xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://www.yworks.com/xml/schema/graphml/1.1/ygraphml.xsd">
  <key id="d0" for="node" yfiles.type="nodegraphics"/>
  <key id="d1" for="edge" yfiles.type="edgegraphics"/>
  <graph id="MeshFillArchitecture" edgedefault="directed">
    <node id="profile">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="40.0" y="120.0" width="220.0" height="72.0"/>
          <y:Fill color="#E8F1FF" transparent="false"/>
          <y:BorderStyle color="#6C8EBF" type="line" width="1.5"/>
          <y:NodeLabel>AutoVoxelProfile&#10;optional shared preset</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="vegetation_asset">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="40.0" y="270.0" width="220.0" height="86.0"/>
          <y:Fill color="#E8F1FF" transparent="false"/>
          <y:BorderStyle color="#6C8EBF" type="line" width="1.5"/>
          <y:NodeLabel>AutoVegetationAsset&#10;direct voxel fields&#10;mesh / scatter config</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="auto_object_fields">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="320.0" y="110.0" width="230.0" height="96.0"/>
          <y:Fill color="#EAF7EA" transparent="false"/>
          <y:BorderStyle color="#82B366" type="line" width="1.5"/>
          <y:NodeLabel>AutoObject fields&#10;voxel_color, complexity&#10;affected_bands, collision</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="typed_object">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="320.0" y="267.0" width="230.0" height="96.0"/>
          <y:Fill color="#EAF7EA" transparent="false"/>
          <y:BorderStyle color="#82B366" type="line" width="1.5"/>
          <y:NodeLabel>AutoRock / AutoVegetation&#10;typed getters&#10;profile fallback only</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="record_builders">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="604.0" y="110.0" width="250.0" height="96.0"/>
          <y:Fill color="#FFF4E6" transparent="false"/>
          <y:BorderStyle color="#D79B00" type="line" width="1.5"/>
          <y:NodeLabel>Record builders&#10;AutoAssetFactory&#10;main.gd attach helpers</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="voxel_record">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="604.0" y="270.0" width="250.0" height="108.0"/>
          <y:Fill color="#FFF4E6" transparent="false"/>
          <y:BorderStyle color="#D79B00" type="line" width="1.5"/>
          <y:NodeLabel>voxel_record&#10;runtime Dictionary&#10;position, pixel, bands&#10;collision, slices</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="metadata">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="604.0" y="480.0" width="250.0" height="86.0"/>
          <y:Fill color="#F3E8FF" transparent="false"/>
          <y:BorderStyle color="#9673A6" type="line" width="1.5"/>
          <y:NodeLabel>metadata&#10;index only&#10;ids + voxel_record handle</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="auto_scene_voxel">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="904.0" y="110.0" width="246.0" height="96.0"/>
          <y:Fill color="#E6FFFB" transparent="false"/>
          <y:BorderStyle color="#2A9D8F" type="line" width="1.5"/>
          <y:NodeLabel>AutoSceneVoxel&#10;automatic source semantics&#10;meshfill / scatter</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="brush_scene_voxel">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="904.0" y="270.0" width="246.0" height="96.0"/>
          <y:Fill color="#E6FFFB" transparent="false"/>
          <y:BorderStyle color="#2A9D8F" type="line" width="1.5"/>
          <y:NodeLabel>BrushSceneVoxel&#10;manual / brush source&#10;override or erase intent</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="vegetation_exclusion">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="904.0" y="450.0" width="246.0" height="116.0"/>
          <y:Fill color="#E6FFFB" transparent="false"/>
          <y:BorderStyle color="#2A9D8F" type="line" width="1.5"/>
          <y:NodeLabel>VegetationExclusion&#10;apply_mesh_voxel_record()&#10;height-band occupancy&#10;collision voxel layer</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="blend">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="1200.0" y="177.0" width="206.0" height="96.0"/>
          <y:Fill color="#FFE8E8" transparent="false"/>
          <y:BorderStyle color="#B85450" type="line" width="1.5"/>
          <y:NodeLabel>blend_scene_voxels&#10;merge source records&#10;tick / priority rules</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="scene_voxel">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="1200.0" y="363.0" width="206.0" height="96.0"/>
          <y:Fill color="#FFE8E8" transparent="false"/>
          <y:BorderStyle color="#B85450" type="line" width="1.5"/>
          <y:NodeLabel>SceneVoxel&#10;committed final state&#10;next tick read model</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="debug_tools">
      <data key="d0">
        <y:ShapeNode>
          <y:Geometry x="1200.0" y="569.0" width="206.0" height="86.0"/>
          <y:Fill color="#EEF2F7" transparent="false"/>
          <y:BorderStyle color="#64748B" type="line" width="1.5"/>
          <y:NodeLabel>Debug / Tools&#10;query metadata&#10;inspect voxel_record</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>

    <edge id="e_profile_object" source="profile" target="auto_object_fields">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#94A3B8" type="dashed" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>fallback preset</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_asset_typed" source="vegetation_asset" target="typed_object">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>instantiate config</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_fields_builders" source="auto_object_fields" target="record_builders">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>read fields</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_typed_builders" source="typed_object" target="record_builders">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>typed getters</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_builders_record" source="record_builders" target="voxel_record">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>derive</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_record_metadata" source="voxel_record" target="metadata">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#94A3B8" type="dashed" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>attach handle</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_record_auto_source" source="voxel_record" target="auto_scene_voxel">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>auto path</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_record_brush_source" source="voxel_record" target="brush_scene_voxel">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>brush path</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_brush_apply" source="brush_scene_voxel" target="vegetation_exclusion">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>apply record</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_auto_blend" source="auto_scene_voxel" target="blend">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>source delta</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_brush_blend" source="brush_scene_voxel" target="blend">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>source delta</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_buffers_blend" source="vegetation_exclusion" target="blend">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>buffers</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_blend_scene" source="blend" target="scene_voxel">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#4B5563" type="line" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>commit</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_metadata_tools" source="metadata" target="debug_tools">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#94A3B8" type="dashed" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>query only</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
    <edge id="e_scene_tools" source="scene_voxel" target="debug_tools">
      <data key="d1"><y:PolyLineEdge><y:LineStyle color="#94A3B8" type="dashed" width="2.0"/><y:Arrows source="none" target="standard"/><y:EdgeLabel>inspect</y:EdgeLabel></y:PolyLineEdge></data>
    </edge>
  </graph>
</graphml>
